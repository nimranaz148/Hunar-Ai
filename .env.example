# === Database ===
DATABASE_URL=postgresql+asyncpg://hunar:hunar_dev@localhost:5432/hunar

# === Authentication ===
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === AI / Agents ===
# Every agent tries OpenRouter first, then falls back to Gemini automatically.
# Set either or both; with neither set, agents use their rule-based fallbacks.
OPENROUTER_API_KEY=
# openrouter/free = free models (20 req/min, 50/day; 1000/day after buying $10 credits).
# For better quality add credits and use e.g. google/gemini-2.5-flash.
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=

# === Super Admin (seed) ===
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# === Application ===
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
